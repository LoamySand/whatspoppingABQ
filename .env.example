# Database Configuration -- the APP's database (currently Supabase; will
# point at the self-hosted container after the SCRUM-27-31 cutover).
# DB_HOST/PORT/NAME/USER default to localhost/5432/postgres/postgres in code
# (see database/db_utils.py) if omitted -- override for Supabase or self-hosted Postgres.
# NOTE: Supabase's pooler username looks like postgres.<project-ref>, not a
# plain "postgres" -- that's expected here, but do NOT reuse these values
# for LOCAL_DB_* below, they're for a different, separate database.
DB_HOST=your_postgres_host_here
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Local self-hosted Postgres container (docker-compose.yml's `postgres`
# service) -- bootstraps its own role/database, kept deliberately separate
# from the DB_* vars above. Pick any plain username/password here; this is
# NOT your Supabase login. Used for: (1) the app's own future data once
# cutover happens, (2) Prefect's orchestration backend (a separate `prefect`
# database on this same instance, see database/schema/docker-init/).
LOCAL_DB_USER=postgres
LOCAL_DB_PASSWORD=choose_a_local_password_here
LOCAL_DB_NAME=event_analytics

# Google Maps API (venue geocoding -- utils/geocoding.py)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# TomTom API (traffic collection -- collectors/tomtom_*.py)
TOMTOM_API_KEY=your_tomtom_api_key_here

# Email alerts (pipeline failure/crash notifications -- utils/notify.py)
ALERT_EMAIL=your_gmail_address_here
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# Prefect orchestration server
# Local dev: http://127.0.0.1:4200/api (default if unset, requires `prefect server start`)
# Self-hosted: http://<pi-host-or-ip>:4200/api
PREFECT_API_URL=http://127.0.0.1:4200/api
